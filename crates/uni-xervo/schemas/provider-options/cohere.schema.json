{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rustic-ai/uni-xervo/main/crates/uni-xervo/schemas/provider-options/cohere.schema.json",
  "title": "Cohere Provider Options",
  "description": "Options for the remote/cohere provider. `$defs/<task>` holds the schema for one task; the top-level schema accepts the keys of any task.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_key_env": {
      "type": "string",
      "description": "Environment variable name that contains the Cohere API key."
    },
    "input_type": {
      "type": "string",
      "description": "Embedding input type (e.g. 'search_document', 'search_query')."
    },
    "embedding_dimensions": {
      "type": "integer",
      "minimum": 1,
      "description": "Embed task only. Override embedding vector dimensions reported by the model handle."
    }
  },
  "$defs": {
    "embed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "$ref": "#/properties/api_key_env"
        },
        "input_type": {
          "$ref": "#/properties/input_type"
        },
        "embedding_dimensions": {
          "$ref": "#/properties/embedding_dimensions"
        }
      }
    },
    "embed_multimodal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "$ref": "#/properties/api_key_env"
        },
        "input_type": {
          "$ref": "#/properties/input_type"
        }
      }
    },
    "generate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "$ref": "#/properties/api_key_env"
        },
        "input_type": {
          "$ref": "#/properties/input_type"
        }
      }
    },
    "rerank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "$ref": "#/properties/api_key_env"
        },
        "input_type": {
          "$ref": "#/properties/input_type"
        }
      }
    }
  }
}

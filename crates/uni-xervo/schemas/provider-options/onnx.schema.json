        "calibration_path": {
          "$ref": "#/properties/calibration_path"
        },
        "label_bank_path": {
          "$ref": "#/properties/label_bank_path"
        }
      },
      "allOf": [
        {
          "not": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "variant"
                    ]
                  },
                  {
                    "required": [
                      "calibration_path"
                    ]
                  },
                  {
                    "required": [
                      "label_bank_path"
                    ]
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "onnx_path"
                    ]
                  },
                  {
                    "required": [
                      "label_maps_path"
                    ]
                  },
                  {
                    "required": [
                      "max_seq_len"
                    ]
                  }
                ]
              }
            ]
          },
          "description": "kniv v7 keys (variant, calibration_path, label_bank_path) and v1 keys (onnx_path, label_maps_path, max_seq_len) cannot be mixed."
        },
        {
          "if": {
            "properties": {
              "generation": {
                "const": "v7"
              }
            },
            "required": [
              "generation"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "onnx_path"
                  ]
                },
                {
                  "required": [
                    "label_maps_path"
                  ]
                },
                {
                  "required": [
                    "max_seq_len"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "generation": {
                "const": "v1"
              }
            },
            "required": [
              "generation"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "variant"
                  ]
                },
                {
                  "required": [
                    "calibration_path"
                  ]
                },
                {
                  "required": [
                    "label_bank_path"
                  ]
                }
              ]
            }
          }
        }
      ]

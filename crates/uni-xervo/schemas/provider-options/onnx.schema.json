{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rustic-ai/uni-xervo/main/crates/uni-xervo/schemas/provider-options/onnx.schema.json",
  "title": "ONNX Provider Options",
  "description": "Options for the local/onnx provider. Each task accepts the shared session keys plus its own; `$defs/<task>` holds the schema for one task, and the top-level schema accepts the keys of any task.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "type": "string",
      "description": "Relative path to the primary .onnx file inside a Hugging Face snapshot."
    },
    "max_batch_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Ceiling used for dynamic batch models."
    },
    "execution_providers": {
      "type": "array",
      "description": "Preferred ONNX Runtime execution providers in priority order.",
      "items": {
        "type": "string",
        "enum": [
          "cpu",
          "cuda",
          "coreml",
          "directml"
        ]
      }
    },
    "graph_optimization_level": {
      "type": "string",
      "enum": [
        "disable",
        "basic",
        "extended",
        "all"
      ],
      "description": "ONNX Runtime graph optimization level."
    },
    "inter_op_num_threads": {
      "type": "integer",
      "minimum": 1,
      "description": "Inter-op thread count passed to ONNX Runtime."
    },
    "intra_op_num_threads": {
      "type": "integer",
      "minimum": 1,
      "description": "Intra-op thread count passed to ONNX Runtime."
    },
    "cache_dir": {
      "type": "string",
      "description": "Overrides UNI_CACHE_DIR and the default .uni_cache/onnx-.../ location."
    },
    "tokenizer_path": {
      "type": "string",
      "description": "Relative path of tokenizer.json within the repo (default: tokenizer.json)."
    },
    "pooling": {
      "type": "string",
      "enum": [
        "cls",
        "mean",
        "max",
        "last-token"
      ],
      "description": "Pooling over token states. Required when no preset matches; last-token suits decoder-style embedders."
    },
    "normalize": {
      "type": "boolean",
      "description": "Apply L2 normalization to each output vector (default: true)."
    },
    "dimensions": {
      "type": "integer",
      "minimum": 1,
      "description": "Output vector width; required when no preset matches and validated against the model."
    },
    "max_seq_len": {
      "type": "integer",
      "minimum": 1,
      "description": "Truncation cap for tokenizer input."
    },
    "token_type_ids": {
      "type": "boolean",
      "description": "Whether the model takes a token_type_ids tensor."
    },
    "output_name": {
      "type": "string",
      "description": "Explicit ONNX output to read; defaults to the first session output."
    },
    "output_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Positional output to read when output_name is not set."
    },
    "style": {
      "type": "string",
      "enum": [
        "cross-encoder",
        "generative",
        "granite-docling",
        "mineru",
        "olmocr"
      ],
      "description": "Rerank: cross-encoder or generative. Document extract: the output dialect, granite-docling, mineru or olmocr."
    },
    "instruction": {
      "type": "string",
      "description": "Generative rerank only. Task description shown to the reranker."
    },
    "generation": {
      "type": "string",
      "enum": [
        "v1",
        "v7"
      ],
      "description": "Which kniv NLP generation the model repo holds. Inferred from the repo (onnx/onnx_meta.json means v7) when omitted."
    },
    "onnx_path": {
      "type": "string",
      "description": "Relative path of the .onnx graph within the repo."
    },
    "label_maps_path": {
      "type": "string",
      "description": "kniv v1 only. Relative path of label_maps.json within the repo."
    },
    "variant": {
      "type": "string",
      "description": "kniv v7 precision fallback chain, e.g. \"\" (fp32), \"fp16\", or \"int8,fp16\": for each graph the first suffix that exists is used, else the fp32 file."
    },
    "calibration_path": {
      "type": "string",
      "description": "Relative path to a kniv v7 calibration.json inside the repo. Default: calibration.json."
    },
    "label_bank_path": {
      "type": "string",
      "description": "Relative path to a kniv v7 label_bank.json inside the repo, which marks the relations whose thresholds were tuned. Default: label_bank.json."
    },
    "image_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Square input edge in pixels."
    },
    "normalization": {
      "type": "string",
      "enum": [
        "siglip",
        "imagenet"
      ],
      "description": "Pixel normalization: siglip ((x/255-0.5)/0.5) or imagenet."
    },
    "pool": {
      "type": "string",
      "enum": [
        "none",
        "mean"
      ],
      "description": "Pooling over the image model's output (default: none)."
    },
    "char_dict_path": {
      "type": "string",
      "description": "Character dictionary file within the repo, one entry per line."
    },
    "image_height": {
      "type": "integer",
      "minimum": 1,
      "description": "Height every text line is resized to (default: 48)."
    },
    "image_width": {
      "type": "integer",
      "minimum": 1,
      "description": "Narrowest a batch of text lines is (default: 320); lines keep their aspect ratio and are right-padded."
    },
    "max_image_width": {
      "type": "integer",
      "minimum": 1,
      "description": "Widest a text line is resized to (default: 3200); must be at least image_width."
    },
    "blank_class": {
      "type": "integer",
      "minimum": 0,
      "description": "The CTC blank's class index (default: 0)."
    },
    "use_space_char": {
      "type": "boolean",
      "description": "Whether the recognizer has a space class after the last dictionary entry. Detected from the model's class count when omitted."
    },
    "det_onnx_path": {
      "type": "string",
      "description": "DBNet detector .onnx within the repo; setting it turns on two-stage detection."
    },
    "det_model_id": {
      "type": "string",
      "description": "Separate Hugging Face repo for the detector (default: the alias's model_id)."
    },
    "det_limit_side": {
      "type": "integer",
      "minimum": 1,
      "description": "Longest side the page is resized to before detection (default: 960)."
    },
    "det_bin_threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "description": "Probability-map binarization threshold (default: 0.3)."
    },
    "det_box_score_threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "description": "Minimum mean box probability to keep a region (default: 0.6)."
    },
    "det_unclip_ratio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Box dilation (unclip) ratio (default: 1.5)."
    },
    "det_min_box_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Minimum box side in detector pixels (default: 3)."
    },
    "det_input_name": {
      "type": "string",
      "description": "Detector input tensor name (default: x)."
    },
    "det_output_name": {
      "type": "string",
      "description": "Detector output tensor name (default: the first output)."
    },
    "sparse_method": {
      "type": "string",
      "enum": [
        "mlm",
        "lexical"
      ],
      "description": "Sparse recipe: SPLADE-style MLM logits or BGE-M3 lexical weights. Required when no preset matches."
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "description": "Keep only the highest-weight terms per sparse vector."
    },
    "drop_special_tokens": {
      "type": "boolean",
      "description": "Drop special-token vectors from multi-vector output (default: false)."
    }
  },

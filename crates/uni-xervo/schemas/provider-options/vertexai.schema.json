{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rustic-ai/uni-xervo/main/crates/uni-xervo/schemas/provider-options/vertexai.schema.json",
  "title": "Vertex AI Provider Options",
  "description": "Options for the remote/vertexai provider. `$defs/<task>` holds the schema for one task; the top-level schema accepts the keys of any task.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_token_env": {
      "type": "string",
      "description": "Environment variable name that contains the Vertex AI OAuth bearer token."
    },
    "project_id": {
      "type": "string",
      "description": "Google Cloud project ID. If omitted, VERTEX_AI_PROJECT is used."
    },
    "location": {
      "type": "string",
      "description": "Vertex AI region (for example, us-central1)."
    },
    "publisher": {
      "type": "string",
      "description": "Model publisher, usually 'google'."
    },
    "embedding_dimensions": {
      "type": "integer",
      "minimum": 1,
      "description": "Embed task only. Override embedding vector dimensions reported by the model handle."
    }
  },
  "$defs": {
    "embed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_token_env": {
          "$ref": "#/properties/api_token_env"
        },
        "project_id": {
          "$ref": "#/properties/project_id"
        },
        "location": {
          "$ref": "#/properties/location"
        },
        "publisher": {
          "$ref": "#/properties/publisher"
        },
        "embedding_dimensions": {
          "$ref": "#/properties/embedding_dimensions"
        }
      }
    },
    "generate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_token_env": {
          "$ref": "#/properties/api_token_env"
        },
        "project_id": {
          "$ref": "#/properties/project_id"
        },
        "location": {
          "$ref": "#/properties/location"
        },
        "publisher": {
          "$ref": "#/properties/publisher"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rustic-ai/uni-xervo/main/crates/uni-xervo/schemas/provider-options/gemini.schema.json",
  "title": "Gemini Provider Options",
  "description": "Options for the remote/gemini provider. `$defs/<task>` holds the schema for one task; the top-level schema accepts the keys of any task.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_key_env": {
      "type": "string",
      "description": "Environment variable name that contains the Gemini API key."
    },
    "api_version": {
      "type": "string",
      "description": "Gemini API version path segment (default: 'v1beta')."
    },
    "embedding_dimensions": {
      "type": "integer",
      "minimum": 1,
      "description": "Embed task only. Override embedding vector dimensions reported by the model handle."
    }
  },
  "$defs": {
    "embed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "$ref": "#/properties/api_key_env"
        },
        "api_version": {
          "$ref": "#/properties/api_version"
        },
        "embedding_dimensions": {
          "$ref": "#/properties/embedding_dimensions"
        }
      }
    },
    "embed_multimodal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "$ref": "#/properties/api_key_env"
        },
        "api_version": {
          "$ref": "#/properties/api_version"
        }
      }
    },
    "generate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "$ref": "#/properties/api_key_env"
        },
        "api_version": {
          "$ref": "#/properties/api_version"
        }
      }
    }
  }
}
